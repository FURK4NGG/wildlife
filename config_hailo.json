{
    "mode": "pir",
    "model": {
        "path": "yolov11l.hef",
        "labels": "labels.txt",
        "confidence": 0.5
    },
    "camera": {
        "width": 1280,
        "height": 960,
        "fps_min": 5,
        "fps_max": 30,
        "fps": 15
    },
    "pir": {
        "gpio_pin": 13,
        "cooldown_seconds": 2.0,
        "capture_image": true,
        "video": {
            "enabled": true,
            "trigger": "detected",
            "seconds": 10
        }
    },
    "continuous": {
        "capture_type": "image",
        "cooldown_seconds": 10.0,
        "video_seconds": 10
    },
    "video": {
        "fps": 15,
        "codec": "mp4v"
    },
    "overlay": {
        "show_fps": true,
        "show_datetime": true,
        "show_class_name": true,
        "show_confidence": true,
        "font_scale": 0.7,
        "line_thickness": 2,
        "background": true
    },
    "detection": {
        "trigger_classes": [
            "bear",
            "boar",
            "wolf",
            "deer"
        ],
        "box_colors": {
            "bear": "#FF8C00",
            "boar": "#8B4513",
            "wolf": "#808080",
            "deer": "#D2691E"
        },
        "default_box_color": "#00FF00"
    },
    "output": {
        "directory": "outputs"
    }
}