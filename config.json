{
    "mode": "pir",

    "model": {
        "path": "model.pt",
        "confidence": 0.50,
        "iou": 0.45,
        "image_size": 640
    },

    "camera": {
        "width": 1280,
        "height": 720,
        "fps_min": 5,
        "fps_max": 30,
        "fps": 15
    },

    "pir": {
        "gpio_pin": 13,
        "cooldown_seconds": 2.0,
        "capture_trigger_image": true,

        "video_trigger": "detected"
    },

    "continuous": {
        "capture_type": "image",
        "cooldown_seconds": 10.0,
        "video_seconds": 10
    },

    "video": {
        "enabled": true,
        "seconds": 10,
        "fps": 15
    },

    "image": {
        "enabled": true
    },

    "overlay": {
        "show_fps": true,
        "show_datetime": true,
        "show_class_name": true,
        "show_confidence": true,
        "font_scale": 0.65,
        "line_thickness": 2
    },

    "detection": {
        "trigger_classes": [
            "bear",
            "boar",
            "wolf",
            "deer"
        ],

        "box_colors": {
            "bear": "#FF8C00",
            "boar": "#8B4513",
            "wolf": "#808080",
            "deer": "#D2691E"
        },

        "default_box_color": "#00FF00"
    },

    "output": {
        "directory": "outputs"
    }
}
